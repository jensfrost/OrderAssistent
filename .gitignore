# ─────────────────────────────
# Node / Expo basics
# ─────────────────────────────
node_modules/
.expo/
.expo-shared/

# Metro / bundler cache etc
*.packager.dev.js
*.packager.prod.js
*.packager.cache
.expo-dev-client.json

# ─────────────────────────────
# Env secrets (keep only *.env.example in repo)
# ─────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────
# PM2 configs
# (IGNORERAS = privat serverkonfig med paths/lösen)
# ─────────────────────────────
ecosystem.config.js
ecosystem.*.config.js
ecosystem.json

# ─────────────────────────────
# Build artifacts / web exports
# Allt som kan genereras igen
# ─────────────────────────────
dist/
web-preview/dist/

app/HundapoteketApp/dist-dev/
app/HundapoteketApp/web/downloads/

# Lägg till fler vid behov:
# app/HundapoteketApp/dist/
# app/HundapoteketApp/dist-preview/

# ─────────────────────────────
# APKs and large binaries
# (IGNORERA binärer men behåll metadata som JSON)
# ─────────────────────────────

# OrderAssistent (DIN APP)
# Ignorera ALLT i downloads rekursivt
app/raw-reorder-app/public/downloads/**

# Tillåt mappar
!app/raw-reorder-app/public/downloads/
!app/raw-reorder-app/public/downloads/dev/

# Tillåt metadata
!app/raw-reorder-app/public/downloads/**/*.json
!app/raw-reorder-app/public/downloads/**/.gitkeep



# ─────────────────────────────
# Logs / runtime junk
# ─────────────────────────────
*.log
*.log.*
logs/
pids/
*.pid
*.seed
*.pid.lock

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# PM2 logs
pm2-*.log
*pm2*out*.log
*pm2*err*.log